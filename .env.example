# Settings read at deploy time and by the helper scripts. No secrets here: AWS credentials come from your normal AWS login.
# Export these in your shell (or load this file) before running `cdk deploy` or the scripts.

# AWS account and region to deploy into
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Resource name prefix and tags (every resource name starts with the prefix)
CLAIMBOLO_PREFIX=claimbolo
CLAIMBOLO_OWNER=your-team
CLAIMBOLO_EXPIRES_AFTER=2026-11-20

# WhatsApp phone number id from the AWS End User Messaging Social console (looks like phone-number-id-...)
WHATSAPP_PHONE_NUMBER_ID=phone-number-id-REPLACE_ME

# Amazon Bedrock model or inference profile id used by the agent (copy it from the Bedrock console)
MODEL_ID=REPLACE_WITH_YOUR_BEDROCK_INFERENCE_PROFILE_ID

# A verified Amazon SES sender address, and where adjuster notifications go
SES_SENDER=sender@example.com
ADJUSTER_EMAIL=adjuster@example.com

# "true" lets any unknown WhatsApp number get a fictional demo policy so judges can try the flow. Use "false" in production.
DEMO_MODE=true

# Optional, for scripts/seed.py: your own WhatsApp test number (E.164) to attach the demo policy to
DEMO_PHONE=+919000000000
SEED_EMAIL=customer@example.com
